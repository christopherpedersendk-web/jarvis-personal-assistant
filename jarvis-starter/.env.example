# Do not commit this file with a real API key.
OPENAI_API_KEY=REPLACE_WITH_YOUR_OWN_KEY
JARVIS_ACCESS_TOKEN=GENERATED_BY_SETUP
OPENAI_TEXT_MODEL=gpt-6.1-sol
OPENAI_VOICE_MODEL=gpt-realtime-2.1
JARVIS_PORT=8787
JARVIS_HOST=127.0.0.1

# Lokal semantisk søgning er et eksplicit valg. Appen downloader aldrig modeller
# og sender aldrig tekst til en ekstern embeddingtjeneste. Klargør den låste
# modelmappe med scripts/prepare-local-semantic-model.mjs før aktivering.
JARVIS_LOCAL_SEMANTIC=no
JARVIS_LOCAL_EMBEDDING_DIR=

# Optional Google Calendar OAuth (read-only scope; HTTPS Tailscale callback).
# Leave blank until Google Cloud OAuth setup is completed.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Optional unofficial Nemlig MCP. OFF unless manually enabled by the owner.
NEMLIG_ENABLE_LIVE=no
NEMLIG_MCP_DIR=
NEMLIG_MCP_UV=
# Credentials should be stored outside this repository in a 0600 config file;
# alternatively NEMLIG_USER and NEMLIG_PASS may be set privately on the server.

# Sonos Control API OAuth (registered HTTPS callback; never commit real credentials)
SONOS_CLIENT_ID=
SONOS_CLIENT_SECRET=
SONOS_REDIRECT_URI=

# v5.1 Responses admission limits (not currency or Realtime audio budgets).
# Unknown paid calls retain their reservation; limits survive restart via state.
JARVIS_API_CALLS_PER_DAY=200
JARVIS_API_OUTPUT_TOKENS_PER_DAY=300000
JARVIS_API_OUTPUT_TOKENS_PER_CALL=22000
JARVIS_API_INPUT_BYTES=512000
